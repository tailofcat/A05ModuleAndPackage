# 默认：由 git 自动判断文本文件，统一以 LF 存入仓库
* text=auto

# 源码与文档显式声明为文本
*.py   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.cfg  text eol=lf
*.lock text eol=lf linguist-generated
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows 批处理必须保持 CRLF，否则无法执行
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制资源：不做换行转换、不做文本 diff
*.mp3 binary
*.wav binary
*.png binary
*.jpg binary
*.ico binary
